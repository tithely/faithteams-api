meta {
  name: Users
  type: http
  seq: 1
}

get {
  url: https://app.faithteams.com/api/v2/users?noloadmask=true
  body: none
  auth: inherit
}

params:query {
  noloadmask: true
}

script:post-response {
  let body = res.getBody();
  bru.setEnvVar("user_id", String(body.data[0].userId));
}

settings {
  encodeUrl: true
}
