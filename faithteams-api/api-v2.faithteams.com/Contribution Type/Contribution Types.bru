meta {
  name: Contribution Types
  type: http
  seq: 1
}

get {
  url: https://api-v2.faithteams.com/contributiontypes
  body: none
  auth: inherit
}

script:post-response {
  let body = res.getBody();
  bru.setEnvVar("contribution_type_id", String(body.data[0].contributionTypeId));
}

settings {
  encodeUrl: true
}
